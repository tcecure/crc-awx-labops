# Copy to compose/.env on the host.
#
# docker-compose.yml alone is the Phase 2 runtime: the model proxy, and nothing else. The
# gateway launches one investigation container per run through
# scripts/run-investigation.sh, so there is no long-lived agent service to compose.
#
# docker-compose.shared-agent.yml is kept only as the rollback to the Phase 1 topology.
# Selecting it means also setting LABOPS_RUNTIME_MODE=shared and
# LABOPS_AGENT_SERVER_URL=http://172.31.241.3:8000 in /etc/labops/gateway.env:
#   COMPOSE_FILE=docker-compose.yml:docker-compose.shared-agent.yml
COMPOSE_FILE=docker-compose.yml
