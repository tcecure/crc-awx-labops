# DigitalRCC LabOps AI — model egress proxy environment template.
#
# Deployed to /etc/labops/model-proxy.env, root:root 0640, read only by the
# labops-model-proxy container. This is the ONLY place on the host where the model provider
# API key exists after the Phase 2 split, and the proxy is the only container with a route
# off the host.

# The real provider key. Install on the host only — never in git, Vercel, Supabase or a ticket.
LABOPS_LLM_API_KEY=REPLACE_ON_HOST_ONLY

# Bearer token the gateway hands to each investigation container. Worthless anywhere except
# the proxy, and rotated with `scripts/split-secrets.sh` / a proxy restart.
LABOPS_MODEL_PROXY_TOKEN=GENERATE_WITH_openssl_rand_-hex_24
