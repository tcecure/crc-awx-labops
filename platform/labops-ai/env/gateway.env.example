# DigitalRCC LabOps AI — gateway environment template (Phase 2 split).
#
# Deployed to /etc/labops/gateway.env on drcc-labops-01, root:labops-gateway 0640, and read
# ONLY by the labops-gateway unit. Nothing in this file may ever be passed into a container,
# a conversation payload, a log line, a ticket, Vercel or a repository.
# Produced from the old single-file layout by scripts/split-secrets.sh.

# --- identity / authorization -------------------------------------------------
LABOPS_OWNER_EMAIL=REPLACE_WITH_OWNER_PORTAL_EMAIL
LABOPS_MAX_ACTIVE_RUNS=1

# --- budgets ------------------------------------------------------------------
LABOPS_RUN_TOKEN_BUDGET=250000
LABOPS_RUN_COST_BUDGET_USD=5.00
LABOPS_MONTHLY_COST_BUDGET_USD=150.00
LABOPS_RUN_WALLCLOCK_MINUTES=20

# --- investigation runtime (checkpoint 3) -------------------------------------
LABOPS_AGENT_IMAGE=ghcr.io/openhands/agent-server:1.42.1-python@sha256:141a3628925a18ad55f07a09c0a1e3db9852ab0043458dbe7c8003c92396d143
LABOPS_AGENT_ENV_FILE=/etc/labops/agent.env
LABOPS_MODEL_NET=compose_labops-model
LABOPS_MODEL_PROXY=172.31.241.2:8081
LABOPS_WORKSPACE_RETENTION_HOURS=0
LABOPS_AGENT_SERVER_API_KEY=GENERATE_WITH_scripts/gen-secrets.sh
LABOPS_AGENT_WEBHOOK_SECRET=GENERATE_WITH_scripts/gen-secrets.sh

# --- Supabase (DRCC project) --------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ON_HOST_ONLY

# --- application --------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://labops.drcc.digitalrcc.com
LABOPS_PUBLIC_URL=https://labops.drcc.digitalrcc.com
LABOPS_BIND_PORT=3100
PORT=3100
NODE_ENV=production
EMAIL_DELIVERY_MODE=mock

# --- read-only integrations ---------------------------------------------------
LABOPS_AWX_URL=http://192.168.1.103:30080/api/v2
LABOPS_AWX_TOKEN=REPLACE_ON_HOST_ONLY          # svc-drcc-labops-ai-ro, scope: read
LABOPS_WIKI_URL=http://192.168.1.42
LABOPS_WIKI_TOKEN=REPLACE_ON_HOST_ONLY         # read-only today; write scope is checkpoint 9
LABOPS_TRACKER_URL=http://192.168.1.61:4000

# --- Phase 2 write switches: all disabled until the checkpoints are approved ---
LABOPS_WRITES_ENABLED=false                    # global emergency disable
LABOPS_GITHUB_WRITES_ENABLED=false
LABOPS_WIKI_WRITES_ENABLED=false
LABOPS_AWX_EXEC_ENABLED=false
# LABOPS_GITHUB_APP_ID=                        # checkpoint 8, not provisioned yet
# LABOPS_GITHUB_INSTALLATION_ID=
# LABOPS_GITHUB_APP_PRIVATE_KEY_FILE=/etc/labops/github-app.pem
# LABOPS_AWX_EXEC_TOKEN=                       # checkpoint 10, not provisioned yet

# --- canary (written by split-secrets.sh; must never be visible to an agent) ---
LABOPS_CANARY_GATEWAY=GENERATED_BY_split-secrets.sh
