# DigitalRCC LabOps AI — environment template
#
# Deployed to /etc/labops/labops.env on drcc-labops-01, root:labops-gateway 0640.
# PLACEHOLDERS ONLY. Never commit a real value to this or any other repository, and
# never copy these values to Vercel, Supabase, a ticket, a log or a workspace.

# --- identity / authorization -------------------------------------------------
LABOPS_OWNER_EMAIL=REPLACE_WITH_OWNER_PORTAL_EMAIL
LABOPS_MAX_ACTIVE_RUNS=1

# --- model provider (OpenAI, Phase 1) -----------------------------------------
LABOPS_LLM_PROVIDER=openai
LABOPS_LLM_MODEL=openai/gpt-5.5
LABOPS_LLM_FALLBACK_MODEL=openai/gpt-4o
LABOPS_LLM_API_KEY=REPLACE_ON_HOST_ONLY
# LABOPS_LLM_BASE_URL=            # only for an OpenAI-compatible proxy
LABOPS_LLM_REQUEST_TIMEOUT_S=120
LABOPS_LLM_MAX_RETRIES=3

# --- budgets ------------------------------------------------------------------
LABOPS_RUN_TOKEN_BUDGET=250000
LABOPS_RUN_COST_BUDGET_USD=5.00
LABOPS_MONTHLY_COST_BUDGET_USD=150.00
LABOPS_RUN_WALLCLOCK_MINUTES=20

# --- agent server (private) ---------------------------------------------------
LABOPS_AGENT_SERVER_URL=http://127.0.0.1:8000
LABOPS_AGENT_SERVER_API_KEY=GENERATE_WITH_scripts/gen-secrets.sh
LABOPS_AGENT_WEBHOOK_SECRET=GENERATE_WITH_scripts/gen-secrets.sh
# consumed by the container itself (same values):
SESSION_API_KEY=${LABOPS_AGENT_SERVER_API_KEY}
OH_SECRET_KEY=GENERATE_WITH_scripts/gen-secrets.sh
OH_TELEMETRY_EXPORTER=none
DO_NOT_TRACK=1

# --- Supabase (DRCC project) --------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ON_HOST_ONLY

# --- read-only integrations ---------------------------------------------------
LABOPS_AWX_URL=http://192.168.1.103:30080/api/v2
LABOPS_AWX_TOKEN=REPLACE_ON_HOST_ONLY          # svc-drcc-labops-ai-ro, scope: read
LABOPS_WIKI_URL=http://192.168.1.42
LABOPS_WIKI_TOKEN=REPLACE_ON_HOST_ONLY         # read-only Wiki.js API token
LABOPS_TRACKER_URL=http://192.168.1.61:4000

# --- app ----------------------------------------------------------------------
LABOPS_PUBLIC_URL=https://labops.digitalrcc.com
LABOPS_BIND_PORT=3100
NODE_ENV=production
