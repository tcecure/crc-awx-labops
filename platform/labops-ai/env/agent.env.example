# DigitalRCC LabOps AI — agent / investigation container environment template.
#
# Deployed to /etc/labops/agent.env, root:root 0640, and supplied to per-investigation
# containers by scripts/run-investigation.sh.
#
# This file is the security boundary: it must contain NO integration credential. No Supabase
# key, no AWX token, no Wiki.js token, no GitHub credential, no SMTP password, no gateway
# session secret, and no provider API key. Every external read or write is performed by the
# gateway; the model provider is reached only through the model proxy, which injects the real
# key upstream (docs/phase2/02-secret-separation.md, 04-network-egress.md).

# --- gateway <-> agent authentication ----------------------------------------
SESSION_API_KEY=GENERATE_WITH_scripts/gen-secrets.sh
OH_SECRET_KEY=GENERATE_WITH_scripts/gen-secrets.sh

# --- model provider, via the proxy only --------------------------------------
LABOPS_LLM_PROVIDER=openai
LABOPS_LLM_MODEL=openai/gpt-5.5
LABOPS_LLM_FALLBACK_MODEL=openai/gpt-4o
LABOPS_LLM_REQUEST_TIMEOUT_S=120
LABOPS_LLM_MAX_RETRIES=3
# Injected per run by run-investigation.sh, not stored here:
#   LABOPS_RUN_ID, LABOPS_LLM_BASE_URL=http://172.31.241.2:8081/v1, LABOPS_MODEL_PROXY_TOKEN

# --- telemetry off ------------------------------------------------------------
OH_TELEMETRY_EXPORTER=none
DO_NOT_TRACK=1

# --- canary (written by split-secrets.sh) -------------------------------------
# Present so scripts/test-secret-isolation.sh can prove it is running in the agent context.
LABOPS_CANARY_AGENT=GENERATED_BY_split-secrets.sh
