[Unit]
# Under per-run isolation this brings up the model proxy only — the investigation
# containers are created by the gateway, one per run, and are not part of the compose
# stack. It still starts the shared agent when compose/.env selects the rollback file.
Description=DigitalRCC LabOps AI - model proxy (and, on rollback, the shared agent server)
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/labops/platform/labops-ai/compose
# Refuses to start if the running image is not the pinned digest.
ExecStartPre=/opt/labops/platform/labops-ai/scripts/check-image-pin.sh
ExecStart=/usr/bin/docker compose up -d --no-build
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
