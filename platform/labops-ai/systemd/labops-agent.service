[Unit]
Description=DigitalRCC LabOps AI - private OpenHands Agent Server (pinned digest)
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/labops/platform/labops-ai/compose
# Refuses to start if the running image is not the pinned digest.
ExecStartPre=/opt/labops/platform/labops-ai/scripts/check-image-pin.sh
ExecStart=/usr/bin/docker compose up -d --no-build
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
